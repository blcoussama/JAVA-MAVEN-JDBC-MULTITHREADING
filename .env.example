# Modèle de configuration locale pour JAVA-MAVEN-JDBC-MULTITHREADING (BiblioTech).
# À copier en « .env » à la racine du dépôt (fichier ignoré par git) : docker compose le lit
# automatiquement. Pour l'application Java, exporter les mêmes variables dans le shell
# (par exemple : set -a; . ./.env; set +a).

# Mot de passe de l'utilisateur applicatif MySQL (obligatoire, à choisir).
BIBLIOTECH_DB_PASSWORD=
# Mot de passe root du conteneur MySQL (obligatoire pour docker compose, à choisir).
BIBLIOTECH_DB_ROOT_PASSWORD=

# Valeurs facultatives (défauts indiqués).
# BIBLIOTECH_DB_USER=bibliotech
# BIBLIOTECH_DB_PORT=3307
# BIBLIOTECH_DB_URL=jdbc:mysql://localhost:3307/bibliotech_db
